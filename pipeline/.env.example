# ─── Growleads Intent — environment ──────────────────────────────────────────
# Copy to .env and fill in. `cp .env.example .env`
#
# The database needs NO configuration: it is a local SQLite file at
# pipeline/data/growleads.db. SQLITE_PATH below only overrides its location.

# ── REQUIRED — LinkedIn scraper (RapidAPI) ───────────────────────────────────
# The only external data source. Get a key at rapidapi.com, then subscribe to
# the LinkedIn data API you intend to use and paste its host here.
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# ── OPTIONAL — per-endpoint overrides ────────────────────────────────────────
# Defaults live in services/linkedin.js; set these only to point at a
# different provider or endpoint path.
RAPIDAPI_PERSON_URL=
RAPIDAPI_PROFILE_UPDATES_URL=
RAPIDAPI_POST_REACTIONS_URL=
RAPIDAPI_POST_COMMENTS_URL=
RAPIDAPI_INTERACTED_PROFILES_URL=
RAPIDAPI_SIMILAR_PROFILES_URL=

# ── OPTIONAL — bulk company enrichment ───────────────────────────────────────
# Powers the headcount/size gate. Without it, company size checks are skipped.
RAPIDAPI_COMPANIES_URL=
RAPIDAPI_BULK_KEY=

# ── OPTIONAL — directIntent AI stage ─────────────────────────────────────────
# Without a key, directIntent.js falls back to regex matching. Lead
# qualification itself is done by Claude in the CLI, not by this key.
OPENAI_API_KEY=

# ── OPTIONAL — database location override ────────────────────────────────────
# SQLITE_PATH=/absolute/path/to/growleads.db
